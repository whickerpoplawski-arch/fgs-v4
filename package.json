{
  "name": "@local/fgs-deepseek-dsh",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "FGS blackboard (Fact -> Step -> Fact) for DeepSeek Harness: single-writer controller, Decide/Execute toolsets, FLAG verify gate.",
  "icon": "./icon.svg",
  "meta": {
    "title": "FGS 黑板",
    "description": "事实→步骤→新事实的黑板：单写者 Controller、Decide/Execute 双 toolset、FLAG 硬门与 reopen。"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "cordis.patch.yml",
    "index.js",
    "client.js",
    "yaml.js",
    "controller",
    "hooks",
    "env",
    "fixtures",
    "io-specs",
    "schemas",
    "prompts",
    "locale",
    "tools",
    "contest",
    "icon.svg",
    "CONTRACT.md",
    "README.md",
    "docs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
